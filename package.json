{
  "name": "daily-diary",
  "version": "1.0.0",
  "description": "A desktop notebook app with S Pen support for precision drawing and note-taking",
  "main": "main.js",
  "homepage": "./",
  "author": "Dragonwinner1",
  "license": "MIT",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "react-test": "react-scripts test",
    "react-eject": "react-scripts eject",
    "electron-start": "wait-on http://localhost:3000 && electron .",
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "npm run react-build && electron-builder",
    "dev": "concurrently \"npm run react-start\" \"electron .\"",
    "test": "npm run react-test"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "electron-squirrel-startup": "^1.1.0"
  },
  "devDependencies": {
    "react-scripts": "5.0.1",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "electron-dev-utils": "^1.12.0",
    "wait-on": "^7.0.1",
    "concurrently": "^8.2.1"
  },
  "build": {
    "appId": "com.dailydiary.app",
    "productName": "Daily Diary",
    "files": [
      "build/**/*",
      "main.js",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
